<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/startup_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_icon_background</item>
        <item name="android:windowBackground">@color/startup_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:navigationBarColor">@color/startup_background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
